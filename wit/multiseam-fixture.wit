package lattice:plugin-host@0.1.0;

/// AP.1 spike world: proves ONE component can `provide` the SYNC grammar seam
/// AND the async `modes` + `config` seams simultaneously — the `auto-pair` shape
/// (grammar actions + an `auto-pairs-mode` minor mode + the `auto-pairs-style`
/// option). The host instantiates the SAME `.wasm` once per seam through each
/// per-seam world's bindings (`GrammarPlugin` sync against the grammar linker;
/// `ModesPlugin` / `ConfigPlugin` async against the async linker); both linkers
/// are supersets carrying every sync seam import, so the fixed import set
/// resolves either way.
///
/// `logging` is intentionally NOT imported: keeping it out of the combined world
/// preserves the "no logging reachable from the grammar hot path" invariant (the
/// grammar linker gains only the sync `modes` / `config` register funcs, never
/// `log`). A test vehicle — the real `auto-pair` world lands at AP.1 proper.
world multiseam-fixture {
    import grammar;
    import buffer;
    import tree-sitter;
    import modes;
    import config;

    export register-grammar: func();
    export grammar-callbacks;
    export register-modes: func();
    export register-options: func();
}
